<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_import_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_panel_storybook"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Wooden Ribbon Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_panel_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/btn_import_game"
            android:src="@drawable/ic_chest_import"
            android:tint="#FFF6DF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/import_title"
            android:textColor="#FFF8E7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/btn_close_import"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_wood_close"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_close"
                android:src="@drawable/ic_close_x" />
        </FrameLayout>
    </LinearLayout>

    <!-- 2-Column Landscape Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Left Column: 4 File Picker Cards with Leaf Checkmarks -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_weight="1.15"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. prod.keys -->
                <LinearLayout
                    android:id="@+id/row_pick_keys"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_inner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/chk_keys"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:alpha="0.22"
                        android:contentDescription="@string/cd_check"
                        android:src="@drawable/ic_check_leaf" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/import_step1_title"
                            android:textColor="#4A2E14"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lbl_pick_keys"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:text="@string/import_step1_hint"
                            android:textColor="#8A6A4A"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_btn_parchment"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/btn_pick"
                        android:textColor="#4A2E14"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. Base Game (.nsp / .xci) -->
                <LinearLayout
                    android:id="@+id/row_pick_base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card_inner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/chk_base"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:alpha="0.22"
                        android:contentDescription="@string/cd_check"
                        android:src="@drawable/ic_check_leaf" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/import_step2_title"
                            android:textColor="#4A2E14"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lbl_pick_base"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:text="@string/import_step2_hint"
                            android:textColor="#8A6A4A"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_btn_parchment"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/btn_pick"
                        android:textColor="#4A2E14"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 3. Update v1.1.2 (.nsp) -->
                <LinearLayout
                    android:id="@+id/row_pick_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card_inner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/chk_update"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:alpha="0.22"
                        android:contentDescription="@string/cd_check"
                        android:src="@drawable/ic_check_leaf" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/import_step3_title"
                            android:textColor="#4A2E14"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lbl_pick_update"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:text="@string/import_step3_hint"
                            android:textColor="#8A6A4A"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_btn_parchment"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/btn_pick"
                        android:textColor="#4A2E14"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 4. DLC (.nsp) -->
                <LinearLayout
                    android:id="@+id/row_pick_dlcs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card_inner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/chk_dlcs"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:alpha="0.22"
                        android:contentDescription="@string/cd_check"
                        android:src="@drawable/ic_check_leaf" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/import_step4_title"
                            android:textColor="#4A2E14"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lbl_pick_dlcs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:text="@string/import_step4_hint"
                            android:textColor="#8A6A4A"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_btn_parchment"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/btn_pick"
                        android:textColor="#4A2E14"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Right Column: Install Summary, Free Storage, Wood-Leaf Progress & Extract CTA -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.85"
            android:background="@drawable/bg_card_inner"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sec_import_status"
                android:textColor="#7A481D"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_import_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F7ECD8"
                android:padding="10dp"
                android:text="@string/import_status_none"
                android:textColor="#4A2E14"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_import_storage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/import_storage_checking"
                android:textColor="#5C3919"
                android:textSize="11sp" />

            <!-- Wood & Leaf Progress Bar -->
            <ProgressBar
                android:id="@+id/prog_import"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_progress_wood"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_import_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="#4E8C3B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Primary Extract Button -->
            <TextView
                android:id="@+id/btn_start_extract"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_btn_leaf"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/btn_start_extract"
                android:textColor="#FFFDF5"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Cancel Extract Button -->
            <TextView
                android:id="@+id/btn_cancel_extract"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_parchment"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/btn_cancel_extract"
                android:textColor="#A6281A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Secondary Clean / Re-Import Button -->
            <TextView
                android:id="@+id/btn_reimport_clean"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_parchment"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/btn_clean_data"
                android:textColor="#7A481D"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
