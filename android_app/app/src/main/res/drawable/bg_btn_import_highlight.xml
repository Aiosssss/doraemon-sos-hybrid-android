<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#D8EEF9" android:endColor="#BEE0F5" />
            <stroke android:width="2.5dp" android:color="#2C74B3" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#44163A59" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FFFDF7" android:centerColor="#F2FAFF" android:endColor="#DCEFFC" />
                    <stroke android:width="2.5dp" android:color="#3A8FD6" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
