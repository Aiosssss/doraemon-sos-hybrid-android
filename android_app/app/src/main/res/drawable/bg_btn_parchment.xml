<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F1DFBE" android:endColor="#E2C799" />
            <stroke android:width="2.5dp" android:color="#7A481D" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#443C220A" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FFFDF7" android:centerColor="#FFF8E7" android:endColor="#F5E5C5" />
                    <stroke android:width="2.5dp" android:color="#8D5B34" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
