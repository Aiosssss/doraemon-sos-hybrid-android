<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4B9137" android:endColor="#366E26" />
            <stroke android:width="2.5dp" android:color="#27521B" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#441E3E14" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#6AB84F" android:endColor="#468334" />
                    <stroke android:width="2.5dp" android:color="#2F5D22" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
