<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#5A3314" />
            <stroke android:width="2.5dp" android:color="#FFF6DF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#A76B3B" android:endColor="#7A481D" />
            <stroke android:width="2.5dp" android:color="#FFF6DF" />
        </shape>
    </item>
</selector>
