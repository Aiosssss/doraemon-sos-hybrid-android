+          (unsigned long long)(fs ? fs->key : 0),
+          S.color.blend_en, bl->src_rgb, bl->dst_rgb, bl->eq_rgb, bl->src_a, bl->dst_a, bl->eq_a,
+          S.chmask.mask, S.ds.dt, S.ds.dw, o ? tbuf : "");
+}
